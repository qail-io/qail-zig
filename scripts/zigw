#!/usr/bin/env bash
set -euo pipefail

repo_root="$(
  cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1
  pwd
)"
zig_local="$repo_root/.tooling/zig-aarch64-macos-0.16.0/zig"
zig_cmd="${ZIG_BIN:-}"

if [[ -z "$zig_cmd" ]]; then
  if [[ -x "$zig_local" ]]; then
    zig_cmd="$zig_local"
  else
    zig_cmd="zig"
  fi
fi

usage() {
  cat <<'EOF'
Usage:
  ./scripts/zigw doctor
  ./scripts/zigw check-raw
  ./scripts/zigw test
  ./scripts/zigw pgzig-bench <qail|pgzig> <single|pool10> [--workload ...] [--plain]

Behavior:
  - Convenience wrapper around `zig build` commands used in this repo.
EOF
}

host_os() {
  uname -s
}

host_arch() {
  uname -m
}

zig_version() {
  "$zig_cmd" version
}

run_check_raw() {
  "$repo_root/scripts/check_no_direct_raw.sh"
  "$repo_root/scripts/check_no_public_raw_runtime.sh"
  "$repo_root/scripts/check_no_public_trusted_ast_helpers.sh"
  "$repo_root/scripts/check_execute_raw_allowlist.sh"
  "$repo_root/scripts/check_raw_cmd_allowlist.sh"
  "$repo_root/scripts/check_sql_string_policy.sh"
}

run_pgzig_bench() {
  "$zig_cmd" build pgzig-bench -- "$@"
}

print_doctor() {
  cat <<EOF
repo_root=$repo_root
zig_bin=$zig_cmd
zig_version=$(zig_version)
host_os=$(host_os)
host_arch=$(host_arch)
EOF
}

main() {
  local cmd="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$cmd" in
    help|-h|--help)
      usage
      ;;
    doctor)
      print_doctor
      ;;
    check-raw)
      run_check_raw
      ;;
    test)
      run_check_raw
      "$zig_cmd" build test
      ;;
    pgzig-bench)
      run_pgzig_bench "$@"
      ;;
    *)
      echo "unknown command: $cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
